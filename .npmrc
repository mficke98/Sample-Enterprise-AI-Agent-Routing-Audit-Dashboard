# Supply-chain hardening.
#
# save-exact pins dependencies to exact versions in package.json rather than
# caret ranges, so `package.json` and `package-lock.json` agree on one version
# and a transitive minor bump can't slip in silently.
#
# The lockfile already carries an SRI integrity hash per package; those hashes
# are only VERIFIED when installing with `npm ci` (which installs strictly from
# the lockfile and fails on any package.json/lock disagreement). `npm install`
# will happily rewrite the lockfile instead. Use `npm ci` for reproducible,
# tamper-evident installs -- see README.
save-exact=true
audit-level=moderate
fund=false
