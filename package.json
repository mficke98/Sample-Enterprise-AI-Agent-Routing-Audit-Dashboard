{
  "name": "agent-routing-audit-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI Agent Routing & Audit Dashboard - local prototype",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server",
    "build": "npm run build --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
